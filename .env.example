# Copy to .env and adjust. Every setting is optional; defaults are shown.

# Where the SQLite database and uploads are stored.
GEOAPI_DATA_DIR=data
# Any SQLAlchemy URL; defaults to sqlite:///<data_dir>/geoapi.db.
# GEOAPI_DATABASE_URL=

# Upload limits.
GEOAPI_MAX_UPLOAD_BYTES=52428800
GEOAPI_MAX_UNCOMPRESSED_BYTES=524288000
GEOAPI_MAX_ARCHIVE_MEMBERS=200
GEOAPI_MAX_DEM_CELLS_PER_FEATURE=25000000

# Projected vs geodesic difference (percent) that adds a warning to a measurement.
GEOAPI_GEODESIC_WARNING_PCT=0.5

# Set to queue background processing on Redis (run `rq worker file-processing`).
# Without it, ?wait=false uses in-process background tasks.
# GEOAPI_REDIS_URL=redis://localhost:6379/0
GEOAPI_JOB_TIMEOUT_SECONDS=600

GEOAPI_LOG_LEVEL=INFO
